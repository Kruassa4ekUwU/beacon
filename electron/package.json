{
  "name": "bacon-desktop",
  "version": "1.0.0",
  "description": "Бекон — P2P file transfer desktop app",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bacon.app",
    "productName": "Бекон",
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    }
  }
}
